# بیرون — متغیرهای محیطی لازم
# این فایل را کپی کنید و به .env.local تغییر نام دهید و مقادیر واقعی را قرار دهید.
# هیچ مقدار واقعی یا secret را در این فایل نگذارید؛ فقط placeholderها باشند.

# === Supabase ===
# Project URL و Anon public key از قسمت Project Settings → API در Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb-public-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (اختیاری و فقط برای اسکریپت‌های سروری و migration)
# Service role key — هرگز در کلاینت یا در جایی که به مرورگر در معرض دید قرار گیرد استفاده نکنید.
SUPABASE_SERVICE_ROLE_KEY=sb-service-role-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Vercel / Production URL ===
# آدرس کامل production برای resolve کردن canonical URLها و OG images. مثلاً: https://beeroon.vercel.app
NEXT_PUBLIC_SITE_URL=

# === Vercel (اختیاری) ===
# اگر از دیتابیس جداگانه Vercel Postgres استفاده می‌کنید، اما به یاد داشته باشید:
# دیتابیس اصلی محصول بیرون = Supabase است؛ این متغیرها ممکن است به یک دیتابیس جداگانه اشاره کنند.
# POSTGRES_HOST=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=
